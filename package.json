{
  "name": "root",
  "private": true,
  "//workspaces": "Read by release-monorepo-semantically to discover releasable packages. pnpm itself uses pnpm-workspace.yaml. Private packages (docs, scripts) are never released.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ci": "pnpm install --frozen-lockfile",
    "build:cjm": "pnpm --filter ts-ioc-container run build:cjm",
    "build:esm": "pnpm --filter ts-ioc-container run build:esm",
    "build:types": "pnpm --filter ts-ioc-container run build:types",
    "generate:docs": "pnpm --filter ts-ioc-container run generate:docs",
    "build": "pnpm --filter ts-ioc-container run build",
    "test": "pnpm --filter ts-ioc-container run test",
    "test:spec": "pnpm --filter ts-ioc-container run test:spec",
    "bench:spec": "pnpm --filter ts-ioc-container run bench:spec",
    "test:coverage": "pnpm --filter ts-ioc-container run test:coverage",
    "type-check": "pnpm --filter ts-ioc-container run type-check",
    "type-check:watch": "pnpm --filter ts-ioc-container run type-check:watch",
    "commit": "cz",
    "format": "pnpm --filter ts-ioc-container run format",
    "format:check": "pnpm --filter ts-ioc-container run format:check",
    "lint": "pnpm --filter ts-ioc-container run lint",
    "lint:fix": "pnpm --filter ts-ioc-container run lint:fix",
    "audit": "npm audit",
    "prepare": "husky",
    "test:react": "pnpm --filter @ts-ioc-container/react run test",
    "type-check:react": "pnpm --filter @ts-ioc-container/react run type-check",
    "lint:react": "pnpm --filter @ts-ioc-container/react run lint",
    "build:react": "pnpm --filter @ts-ioc-container/react run build",
    "test:all": "pnpm test && pnpm run test:react",
    "build:all": "pnpm run build && pnpm run build:react",
    "docs:dev": "pnpm --filter ts-ioc-container-docs run dev",
    "docs:serve": "pnpm --filter ts-ioc-container-docs run dev",
    "docs:build": "pnpm --filter ts-ioc-container-docs run build",
    "docs:preview": "pnpm --filter ts-ioc-container-docs run preview"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.24.0",
    "@types/node": "^25.5.2",
    "@typescript-eslint/eslint-plugin": "8.32.1",
    "@typescript-eslint/parser": "8.59.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "9.24.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "release-monorepo-semantically": "1.9.1",
    "tsx": "^4.21.0",
    "typescript": "5.8.3"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "docs/**/*.{js,ts,tsx,mjs,astro}": [
      "prettier --write"
    ],
    "docs/**/*.astro": [
      "eslint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd",
  "engines": {
    "node": ">= 18"
  }
}
