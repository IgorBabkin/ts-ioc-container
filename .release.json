{
  "report": {
    "bumps": {
      "patch": [
        { "type": "fix", "scope": "<package>" },
        { "type": "perf", "scope": "<package>" },
        { "type": "docs", "scope": "<package>" }
      ]
    },
    "squash": "github"
  },
  "vcs": {
    "template": "packages/scripts/release/templates/release-commit-msg.hbs"
  },
  "package-manager": {
    "kind": "pnpm"
  }
}
