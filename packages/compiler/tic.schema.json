{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/IgorBabkin/ts-ioc-container/tree/main/packages/compiler/tic.schema.json",
  "title": "tic.config.json",
  "description": "Container modules generated by `tic build` (@ts-ioc-container/compiler). Relative paths resolve against this file's directory.",
  "type": "object",
  "required": [
    "modules"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "tsconfig": {
      "type": "string",
      "description": "tsconfig whose `paths` aliases namespaces and imports may use. Default `tsconfig.json`, which may be absent."
    },
    "importExtension": {
      "type": "string",
      "description": "Extension of generated imports, e.g. \".js\". Inferred from the tsconfig: \".js\" under node16/nodenext resolution, none otherwise."
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "output",
          "namespaces"
        ],
        "additionalProperties": false,
        "properties": {
          "output": {
            "type": "string",
            "minLength": 1,
            "description": "The generated .ts file."
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_$][\\w$]*$",
            "default": "ContainerModule",
            "description": "Name of the exported IContainerModule."
          },
          "namespaces": {
            "type": "array",
            "minItems": 1,
            "description": "Folders to scan: paths relative to this file (./src/services) or tsconfig paths aliases (@app/services).",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "required": [
                    "path"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "recursive": {
                      "type": "boolean",
                      "default": true
                    }
                  }
                }
              ]
            }
          },
          "select": {
            "type": "object",
            "additionalProperties": false,
            "description": "How target classes are picked out of a file. A class is selected when it is exported, not abstract, and meets every criterion set here; omit it to register every exported class.",
            "properties": {
              "export": {
                "enum": [
                  "any",
                  "named",
                  "default"
                ],
                "default": "any",
                "description": "Which exports count."
              },
              "decorators": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "The class must carry one of these decorators, recognised by name (e.g. \"register\", or a composed decorator)."
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Glob the class name must match, e.g. \"*Service\". An anonymous default export is named after its file."
              }
            }
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "**/*.spec.ts",
              "**/*.test.ts",
              "**/*.spec.tsx",
              "**/*.test.tsx",
              "**/__tests__/**",
              "**/node_modules/**"
            ],
            "description": "Globs, relative to this file, of files never scanned. Replaces the default when given."
          }
        }
      }
    }
  }
}
