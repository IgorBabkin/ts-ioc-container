{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2022"],
    "types": ["node"],
    "moduleResolution": "Node",
    "noImplicitReturns": true,
    "strict": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "removeComments": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["./lib"]
}
