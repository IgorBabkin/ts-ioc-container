{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "lib": ["es2022"],
    "types": ["vitest/globals", "node"],
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noImplicitReturns": true,
    "strict": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "isolatedModules": true,
    "paths": {
      "@app/*": ["./__tests__/fixtures/app/src/*"]
    }
  },
  "include": ["lib", "__tests__"],
  "//exclude": "The fixture is a consumer project with its own tsconfig (paths aliases); the e2e spec type-checks it against that.",
  "exclude": ["node_modules", "cjm", "typings", "__tests__/fixtures"]
}
