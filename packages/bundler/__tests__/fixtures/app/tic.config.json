{
  "$schema": "../../../tic.schema.json",
  "bundles": [
    {
      "output": "src/di/app.bundle.ts",
      "name": "AppBundle",
      "namespaces": ["@app/services", "@app/infra"],
      "select": {
        "decorators": ["register"]
      },
      "tags": ["app"]
    }
  ],
  "groups": [
    {
      "name": "AppGroup",
      "output": "src/di/{name}.generated.ts",
      "bundleTags": ["app"]
    }
  ]
}
