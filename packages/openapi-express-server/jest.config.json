{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>/__tests__"],
  "testMatch": ["**/?(*.)+(spec|test).+(ts)"],
  "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "cjs", "json", "node"],
  "collectCoverageFrom": ["lib/**/*.{ts,tsx}", "!lib/**/*.d.ts"],
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.test.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^@ibabkin/openapi-to-server$": "<rootDir>/../openapi-to-server-interface/lib/index.ts",
    "^@ibabkin/openapi-to-server/identifier$": "<rootDir>/../openapi-to-server-interface/lib/utils/identifier.ts",
    "^@ibabkin/openapi-to-zod$": "<rootDir>/../openapi-to-request-validator/lib/index.ts",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transformIgnorePatterns": ["node_modules/(?!.*\\.mjs$)"]
}
