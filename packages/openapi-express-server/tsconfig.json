{
  "compilerOptions": {
    "outDir": "./cjm",
    "rootDir": "./lib",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "target": "ES6",
    "module": "commonjs",
    "baseUrl": ".",
    "paths": {
      "@ibabkin/openapi-to-server-interface": ["../openapi-to-server-interface/cjm/index"],
      "@ibabkin/openapi-to-request-validator": ["../openapi-to-request-validator/cjm/index"]
    },
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "lib/**/*"
  ],
  "exclude": [
    "node_modules",
    "cjm",
    "__tests__"
  ]
}
