{
  "compilerOptions": {
    "outDir": "./cjm",
    "rootDir": "./lib",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "target": "ES6",
    "module": "commonjs",
    "baseUrl": "./lib",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "references": [
    { "path": "../openapi-framework" }
  ],
  "include": [
    "lib/**/*"
  ],
  "exclude": [
    "node_modules",
    "cjm",
    "__tests__"
  ]
}
