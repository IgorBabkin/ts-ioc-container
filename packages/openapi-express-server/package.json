{
  "name": "@ibabkin/openapi-express-server",
  "version": "1.0.0",
  "description": "Express.js server implementation for OpenAPI-generated interfaces",
  "keywords": [
    "openapi",
    "swagger",
    "express",
    "server",
    "typescript"
  ],
  "author": "ibabkin <igba14@gmail.com>",
  "homepage": "https://github.com/IgorBabkin/ts-ioc-container/tree/master/packages/openapi-express-server",
  "license": "ISC",
  "main": "cjm/index.js",
  "types": "cjm/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgorBabkin/ts-ioc-container.git"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "cjm/**/*"
  ],
  "scripts": {
    "build": "npm run clean && npm run compile",
    "test": "jest",
    "test:generate:code": "tsx ./__tests__/generate.ts",
    "test:watch": "jest --coverage --watch",
    "clean": "rimraf cjm",
    "watch": "nodemon --watch lib --exec 'npm run compile'",
    "compile": "tsc -p tsconfig.json --outDir cjm"
  },
  "dependencies": {
    "@ibabkin/openapi-to-server-interface": "workspace:*",
    "@ibabkin/openapi-to-request-validator": "workspace:*",
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "reflect-metadata": "^0.2.2",
    "ts-ioc-container": "^46.6.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "29.5.14",
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.2",
    "jest": "29.7.0",
    "openapi-types": "^12.1.0",
    "rimraf": "3.0.2",
    "supertest": "^6.3.3",
    "ts-jest": "29.2.5",
    "tsx": "^4.21.0",
    "typescript": "5.7.3"
  }
}
