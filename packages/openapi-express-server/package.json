{
  "name": "@ts-ioc-container/openapi-express-server",
  "version": "3.2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Express.js server implementation for OpenAPI-generated interfaces",
  "keywords": [
    "openapi",
    "swagger",
    "express",
    "server",
    "typescript"
  ],
  "author": "ibabkin <igba14@gmail.com>",
  "homepage": "https://github.com/IgorBabkin/ts-ioc-container/tree/main/packages/openapi-express-server#readme",
  "license": "ISC",
  "type": "module",
  "main": "esm/index.js",
  "types": "esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./esm/index.d.ts",
      "import": "./esm/index.js"
    },
    "./AGENTS.md": "./AGENTS.md",
    "./package.json": "./package.json"
  },
  "module": "esm/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgorBabkin/ts-ioc-container",
    "directory": "packages/openapi-express-server"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "esm/**/*",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run build:ts",
    "test": "jest",
    "test:generate:code": "tsx ./__tests__/generate.ts && prettier --write __tests__/operations.ts __tests__/validators.ts",
    "test:watch": "jest --coverage --watch",
    "clean": "rimraf esm *.tsbuildinfo",
    "watch": "nodemon --watch lib --exec 'pnpm run compile'",
    "build:ts": "tsc -p tsconfig.prod.json",
    "test:coverage": "jest --coverage --coverageReporters=lcov",
    "type-check": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint \"lib/**/*.ts\" \"__tests__/**/*.ts\"",
    "lint:fix": "pnpm run lint --fix",
    "format": "prettier --write \"lib/**/*.ts\" \"__tests__/**/*.ts\"",
    "format:check": "prettier --check \"lib/**/*.ts\" \"__tests__/**/*.ts\""
  },
  "dependencies": {
    "@ts-ioc-container/openapi-to-zod": "workspace:*",
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "reflect-metadata": "^0.2.2",
    "ts-ioc-container": "workspace:^",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@jest/test-sequencer": "29.7.0",
    "@ts-ioc-container/openapi-to-server": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/jest": "29.5.14",
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.2",
    "jest": "29.7.0",
    "openapi-types": "^12.1.0",
    "rimraf": "3.0.2",
    "supertest": "^6.3.3",
    "ts-jest": "29.4.12",
    "tsx": "^4.23.13",
    "typescript": "5.8.3",
    "yaml": "^2.8.3",
    "yaml-import": "^2.0.0"
  },
  "engines": {
    "node": ">= 18"
  }
}
