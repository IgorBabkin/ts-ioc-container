{
  "testMatch": [
    "**/?(*.)+(spec|test).+(ts)"
  ],
  "transform": {
    "^.+\\.tsx?$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!.*\\.mjs$)",
    "precompiled/"
  ],
  "coveragePathIgnorePatterns": [
    "/node_modules/",
    "/fixtures/",
    "/cjm/",
    "/esm/",
    "/precompiled/"
  ],
  "moduleDirectories": [
    "node_modules",
    "<rootDir>"
  ]
}
