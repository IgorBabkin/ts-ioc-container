import {z} from 'zod';

const zNumber = z.string().regex(/^\d+$/).transform(Number);

const zDate = z.preprocess((arg) => {
  if (typeof arg === 'string' || typeof arg === 'number') {
    return new Date(arg);
  }

  return arg;
}, z.date());

{{#each components.schemas as |component componentName|}}
export const {{componentName}} = {{{render_template 'ValidationJsonSchema.hbs' component}}};
{{/each}}

export const PAYLOADS = {
{{#each paths as |path url|}}
  {{#each (get_methods_obj path)}}
    {{operationId}}: {{{render_template 'ValidationRoute.hbs' this}}},
  {{/each}}
{{/each}}
};
