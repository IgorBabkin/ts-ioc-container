{
  "compilerOptions": {
    "baseUrl": "./lib",
    "lib": ["es2016"],
    "types": ["jest", "node"],
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "esm"]
}
