{
  "name": "@ibabkin/openapi-to-server-interface",
  "version": "1.0.0",
  "description": "Generates TypeScript server interfaces from OpenAPI specifications",
  "keywords": [
    "openapi",
    "swagger",
    "server",
    "interface",
    "types",
    "typescript",
    "codegen"
  ],
  "author": "ibabkin <igba14@gmail.com>",
  "homepage": "https://github.com/IgorBabkin/ts-ioc-container/tree/master/packages/openapi-to-server-interface",
  "license": "ISC",
  "main": "cjm/index.js",
  "types": "cjm/index.d.ts",
  "exports": {
    ".": {
      "import": "./cjm/index.js",
      "require": "./cjm/index.js",
      "types": "./cjm/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgorBabkin/ts-ioc-container.git"
  },
  "sideEffects": true,
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "cjm/**/*",
    "precompiled/**/*"
  ],
  "scripts": {
    "build": "npm run clean && npm run compile",
    "test": "npm run hbs:compile && make-dir .generated && jest",
    "test:watch": "jest --coverage --watch",
    "hbs:compile": "handlebars lib/templates/*.hbs -f precompiled.js -c handlebars/runtime",
    "clean": "rimraf cjm",
    "watch": "nodemon --watch lib --exec 'npm run compile'",
    "compile": "npm run hbs:compile && tsc -p tsconfig.json --outDir cjm"
  },
  "dependencies": {
    "handlebars": "^4.7.7",
    "js-yaml": "^4.1.0",
    "yaml-import": "^2.0.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/js-yaml": "^4.0.5",
    "jest": "29.7.0",
    "make-dir-cli": "^3.0.0",
    "nodemon": "^2.0.22",
    "openapi-types": "^12.1.0",
    "rimraf": "3.0.2",
    "ts-jest": "29.2.5",
    "typescript": "5.7.3"
  }
}
