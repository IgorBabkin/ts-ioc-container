{
  "name": "@ibabkin/openapi-to-server",
  "version": "2.0.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Generates TypeScript server interfaces from OpenAPI specifications",
  "keywords": [
    "openapi",
    "swagger",
    "server",
    "interface",
    "types",
    "typescript",
    "codegen"
  ],
  "author": "ibabkin <igba14@gmail.com>",
  "homepage": "https://github.com/IgorBabkin/openapi-to-server/tree/master/packages/openapi-to-server-interface",
  "license": "ISC",
  "type": "module",
  "main": "esm/index.js",
  "types": "esm/index.d.ts",
  "exports": {
    ".": {
      "import": "./esm/index.js",
      "types": "./esm/index.d.ts"
    }
  },
  "module": "esm/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgorBabkin/openapi-to-server.git"
  },
  "sideEffects": true,
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "bin/**/*",
    "esm/**/*",
    "hbs/**/*"
  ],
  "bin": {
    "openapi-to-server": "bin/openapi-to-server.js",
    "openapi-to-client": "bin/openapi-to-client.js"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:hbs && pnpm run build:ts",
    "test": "pnpm run build:hbs && make-dir .generated && jest",
    "test:watch": "jest --coverage --watch",
    "clean": "rimraf esm *.tsbuildinfo",
    "watch": "nodemon --watch lib --exec 'pnpm run build'",
    "build:ts": "tsc -p tsconfig.prod.json --outDir esm",
    "build:hbs": "make-dir hbs && handlebars lib/templates/*.hbs -f hbs/index.cjs -c handlebars"
  },
  "dependencies": {
    "handlebars": "^4.7.9",
    "js-yaml": "^4.1.0",
    "openapi-types": "^12.1.0",
    "yaml-import": "^2.0.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/js-yaml": "^4.0.5",
    "jest": "29.7.0",
    "make-dir-cli": "^3.0.0",
    "nodemon": "^2.0.22",
    "rimraf": "3.0.2",
    "ts-jest": "29.4.12",
    "typescript": "5.7.3"
  }
}
