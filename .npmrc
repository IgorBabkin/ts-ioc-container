# package.json's root `workspaces` field exists so `release-monorepo-semantically`
# can discover packages to release (it only reads `package.json#workspaces`,
# not `pnpm-workspace.yaml`). That field also makes `pnpm version` — used by the
# package-manager release step — treat this as an npm/yarn-style workspace and
# reconcile a package-lock.json via `npm install` as a side effect. This repo
# is pnpm-only, so that reconciliation is unwanted; this setting turns it off.
workspaces-update=false
